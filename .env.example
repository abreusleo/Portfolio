# Base URL of the recados service (server/recados). Without it the message wall
# does not appear at all and the room is unaffected.
#
#   local:  VITE_RECADOS_API=http://127.0.0.1:8099
#   live:   VITE_RECADOS_API=https://msg.leo-abreu.com
VITE_RECADOS_API=

# Para rodar o mural na sua máquina, suba o serviço em server/recados com:
#
#   cd server/recados
#   RECADOS_ADDR=:8099 RECADOS_DB=C:/tmp/recados.db #   RECADOS_IP_SALT=dev-salt RECADOS_ORIGINS=http://localhost:5173 #   TRUSTED_PROXIES=127.0.0.1/32 #   RECADOS_WRITE_EVERY_SECONDS=2 RECADOS_WRITE_PER_DAY=500 go run .
#
# Os dois últimos afrouxam o limite de escrita para você conseguir colar vários
# recados seguidos enquanto testa. Em produção, não passe nenhum dos dois.
#
# O banco vai para fora do repositório de propósito: nada em server/ o ignora.
